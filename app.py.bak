import csv
from flask import Flask, render_template
import pymysql

app = Flask(__name__)

db = pymysql.connect(
    host="SERVIDOR",
    user="root",
    password="123456",
    database="sysloja",
    cursorclass=pymysql.cursors.DictCursor
)

CSV_PATH = "catalogo.csv"


# =========================
# 🔥 FILTRO JINJA (BRL)
# =========================
@app.template_filter("brl")
def brl(value):
    if value is None:
        return "R$ 0,00"

    try:
        v = float(value)
    except:
        return value

    # 🔥 CORREÇÃO CENTAVOS -> REAIS
    # ex: 289 -> 2.89
    if v >= 100 and v.is_integer():
        v = v / 100

    return f"R$ {v:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")


def ler_catalogo():
    ativos = set()

    with open(CSV_PATH, newline="", encoding="utf-8-sig") as f:
        reader = csv.DictReader(f, delimiter=";")

        for row in reader:
            if row.get("ativo", "").strip() == "1":
                try:
                    ativos.add(int(row["CodPro"]))
                except:
                    pass

    return ativos


# =========================
# HOME
# =========================
@app.route("/")
def home():

    ativos = ler_catalogo()

    with db.cursor() as cursor:
        cursor.execute("SELECT CodGru, DesGru FROM cdgrupos")
        grupos = {
            g["CodGru"]: g["DesGru"]
            for g in cursor.fetchall()
        }

    with db.cursor() as cursor:
        cursor.execute("SELECT * FROM produtos")
        rows = cursor.fetchall()

    produtos = []
    categorias_set = set()

    for p in rows:
        try:
            cod = int(p["CodPro"])

            if cod not in ativos:
                continue

            codgru = p.get("CodGru")
            nome_categoria = grupos.get(codgru, "SEM CATEGORIA")

            categorias_produto = [nome_categoria]

            qnt_prom = p.get("QntProm", 0)

            if qnt_prom and int(qnt_prom) > 0:
                categorias_produto.append("PROMOÇÕES")

            # =========================
            # 🔥 MAPEAMENTO DE PREÇO
            # =========================
            preco_ven = p.get("PcoVen", 0)
            preco_prom = p.get("PcoProm", 0)

            # converte centavos → reais
            def conv(v):
                try:
                    v = float(v)
                except:
                    return 0

                if v >= 100 and v.is_integer():
                    v = v / 100

                return v

            p["preco"] = conv(preco_ven)
            p["preco_prom"] = conv(preco_prom)

            p["imagem"] = f"/static/imagens/{cod}.jpg"
            p["categoria"] = ",".join(categorias_produto)

            produtos.append(p)

            for c in categorias_produto:
                categorias_set.add(c)

        except:
            pass

    categorias = ["TODOS"] + sorted(categorias_set)

    return render_template(
        "index.html",
        produtos=produtos,
        categorias=categorias
    )


if __name__ == "__main__":
    app.run(debug=True)